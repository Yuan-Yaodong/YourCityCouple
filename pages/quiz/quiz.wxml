<!--pages/quiz/quiz.wxml-->
<view class="container">
  <!-- 进度条 -->
  <view class="progress-wrap">
    <view class="progress-bar">
      <view class="progress-inner" style="width: {{progressPercent}}%"></view>
    </view>
    <text class="progress-text">{{currentQuestion + 1}}/{{totalQuestions}}</text>
    <text wx:if="{{currentQuestion >= 2}}" class="progress-hint">你已经完成一半啦，马上揭晓结果</text>
  </view>

  <!-- 问题卡片 -->
  <view class="question-card {{slideDirection}}">
    <!-- 问题序号 -->
    <view class="question-num">
      <text>第{{currentQuestion + 1}}题</text>
    </view>

    <!-- 问题内容 -->
    <text class="question-text">{{question.question}}</text>

    <!-- 选项列表 -->
    <view class="options-list">
      <view
        wx:for="{{question.options}}"
        wx:key="index"
        class="option-item {{selectedIndex === index ? 'selected' : ''}}"
        bindtap="selectOption"
        data-index="{{index}}"
        style="animation-delay: {{index * 0.1}}s"
      >
        <text class="option-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <button
    wx:if="{{currentQuestion > 0}}"
    class="btn-prev"
    bindtap="prevQuestion"
    disabled="{{animating}}"
  >
    返回上一题修改
  </button>

  <!-- 底部装饰 -->
  <view class="footer-decor">
    <text>🧧</text>
    <text>🎊</text>
    <text>🏮</text>
  </view>
</view>
