<!--pages/result/result.wxml-->
<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{!showResult}}" class="loading">
    <text>正在计算你的运势...</text>
  </view>

  <!-- 结果内容 -->
  <view wx:else class="result-content">
    <!-- 顶部装饰 -->
    <view class="top-decor {{showAnimations ? 'fade-in' : ''}}">
      <text>🧧</text>
      <text>🎊</text>
      <text>🏮</text>
    </view>

    <!-- 结果标题 -->
    <view class="result-header {{showAnimations ? 'slide-up' : ''}}" style="animation-delay: 0.2s">
      <text class="result-label">你的开年旺城是</text>
      <text class="result-emoji">{{cityDetail.emoji}}</text>
      <text class="result-city">{{result.city}}</text>
    </view>

    <view class="core-summary-card {{showAnimations ? 'fade-in' : ''}}">
      <view class="core-summary-title">一句话结论</view>
      <text class="core-summary-text">{{coreSummaryText}}</text>
      <text wx:if="{{runnerUpCity}}" class="core-summary-sub">差一点就是：{{result.runnerUp.city}} {{runnerUpCity.emoji}}</text>
      <text wx:if="{{compareText}}" class="core-summary-sub">和上次相比：{{compareText}}</text>
    </view>

    <!-- 历史摘要卡片 -->
    <view wx:if="{{historySummary.hasHistory}}" class="history-card {{showAnimations ? 'fade-in' : ''}}" style="animation-delay: 0.3s">
      <view class="history-header">
        <text class="history-title">测试足迹</text>
        <view wx:if="{{historySummary.streakBadge}}" class="streak-badge badge-{{historySummary.streakBadge.level}}">
          <text class="streak-emoji">{{historySummary.streakBadge.emoji}}</text>
          <text class="streak-label">{{historySummary.streakBadge.label}}</text>
        </view>
      </view>
      <view class="history-stats">
        <view class="history-stat">
          <text class="history-stat-value">{{historySummary.totalTests}}</text>
          <text class="history-stat-label">累计测试</text>
        </view>
        <view class="history-stat">
          <text class="history-stat-value">{{historySummary.uniqueCities}}</text>
          <text class="history-stat-label">探索城市</text>
        </view>
      </view>
      <view class="history-recent">
        <text class="history-recent-label">最近测试：</text>
        <view class="history-cities">
          <text wx:for="{{historySummary.recentCities}}" wx:key="index" class="history-city-tag">
            {{item.city}} · {{item.time}}
          </text>
        </view>
      </view>
    </view>

    <!-- 首次测试提示 -->
    <view wx:if="{{!historySummary.hasHistory}}" class="history-card history-first {{showAnimations ? 'fade-in' : ''}}" style="animation-delay: 0.3s">
      <text class="history-first-text">🎯 开启你的好运探索之旅！</text>
    </view>

    <!-- 城市描述 -->
    <view class="city-card {{showAnimations ? 'slide-up' : ''}}" style="animation-delay: 0.4s">
      <text class="city-desc">{{cityDetail.description}}</text>

      <!-- 标签 -->
      <view class="tags">
        <text wx:for="{{cityDetail.tags}}" wx:key="index" class="tag {{showAnimations ? 'fade-in' : ''}}" style="animation-delay: {{0.6 + index * 0.15}}s">
          {{item}}
        </text>
      </view>

      <!-- 详细介绍 -->
      <text class="city-detail {{showAnimations ? 'fade-in' : ''}}" style="animation-delay: {{0.6 + cityDetail.tags.length * 0.15}}s">{{cityDetail.detail}}</text>

      <button class="btn-toggle-details" bindtap="toggleExtendedDetails">
        {{showExtendedDetails ? '收起详细解析' : '展开详细解析'}}
      </button>

      <view wx:if="{{showExtendedDetails}}" class="extended-details">
        <!-- 分析文案 -->
        <view wx:if="{{analysis}}" class="analysis-section {{showAnimations ? 'slide-up' : ''}}" style="animation-delay: {{0.6 + (cityDetail.tags.length + 1) * 0.15}}s">
          <view class="analysis-title">为什么适合你</view>
          <view class="analysis-item" wx:for="{{displayWhyFit}}" wx:key="index">
            <text class="analysis-point">{{item.text}}</text>
            <text class="analysis-desc">{{item.desc}}</text>
          </view>
          <view class="analysis-summary">{{analysis.summary}}</view>
        </view>

        <!-- MBTI人格卡片 -->
        <view wx:if="{{mbti}}" class="mbti-card {{showAnimations ? 'slide-up' : ''}}" style="animation-delay: {{0.7 + (cityDetail.tags.length + 1) * 0.15}}s">
          <view class="mbti-header">
            <text class="mbti-emoji">{{mbti.emoji}}</text>
            <view class="mbti-title-wrap">
              <text class="mbti-type">{{mbti.type}}</text>
              <text class="mbti-name">{{mbti.name}}</text>
            </view>
          </view>
          <text class="mbti-desc">来源：{{mbti.source === 'self_reported' ? '你的自选MBTI' : '系统推断MBTI'}}</text>
          <text class="mbti-desc">{{mbti.description}}</text>
          <view class="mbti-travel">
            <text class="mbti-travel-label">旅行风格</text>
            <text class="mbti-travel-text">{{mbti.travelStyle}}</text>
          </view>
        </view>

        <!-- MBTI+生肖人格解读卡片 -->
        <view wx:if="{{personalityInsight}}" class="personality-card {{showAnimations ? 'slide-up' : ''}}" style="animation-delay: {{0.75 + (cityDetail.tags.length + 1) * 0.15}}s">
          <view class="personality-header">
            <text class="personality-emoji">🔮</text>
            <text class="personality-title">人格深度解读</text>
          </view>
          <view class="personality-section" wx:if="{{personalityInsight.mbtiAnalysis}}">
            <view class="personality-dimension" wx:for="{{personalityInsight.mbtiAnalysis}}" wx:key="dimension">
              <text class="personality-dim-label">{{item.dimension}}</text>
              <text class="personality-dim-value">{{item.tendency}}</text>
              <text class="personality-dim-desc">{{item.description}}</text>
            </view>
          </view>
          <view class="personality-section" wx:if="{{personalityInsight.zodiacAxis}}">
            <view class="personality-zodiac">
              <text class="personality-zodiac-label">生肖轴解读</text>
              <text class="personality-zodiac-value">{{personalityInsight.zodiacAxis.label}}</text>
              <text class="personality-zodiac-desc">{{personalityInsight.zodiacAxis.description}}</text>
            </view>
          </view>
          <view class="personality-combo" wx:if="{{personalityInsight.combinedInsight}}">
            <text class="personality-combo-title">组合洞察</text>
            <text class="personality-combo-text">{{personalityInsight.combinedInsight}}</text>
          </view>
        </view>

        <!-- 五行属性卡片 -->
        <view wx:if="{{fiveElement}}" class="five-element-card {{showAnimations ? 'slide-up' : ''}}" style="animation-delay: {{0.8 + (cityDetail.tags.length + 1) * 0.15}}s">
          <view class="five-element-header">
            <text class="five-element-emoji">{{fiveElement.detail.emoji}}</text>
            <text class="five-element-title">你的五行属性</text>
          </view>
          <view class="five-element-name">{{fiveElement.detail.name}}属</view>
          <view class="five-element-info">
            <view class="five-element-item">
              <text class="five-element-label">幸运色</text>
              <text class="five-element-value">{{fiveElementLuckyColorsText}}</text>
            </view>
            <view class="five-element-item">
              <text class="five-element-label">幸运数字范围</text>
              <text class="five-element-value">{{fiveElementLuckyNumbersText}}</text>
            </view>
            <view class="five-element-item">
              <text class="five-element-label">贵人方位</text>
              <text class="five-element-value">{{fiveElement.detail.direction}}</text>
            </view>
          </view>
          <text class="five-element-fortune">{{fiveElement.detail.fortune}}</text>
        </view>

        <view wx:if="{{zodiacProfile}}" class="five-element-card {{showAnimations ? 'slide-up' : ''}}" style="animation-delay: {{0.85 + (cityDetail.tags.length + 1) * 0.15}}s">
          <view class="five-element-header">
            <text class="five-element-emoji">🧿</text>
            <text class="five-element-title">生肖运势关联</text>
          </view>
          <view class="five-element-name">{{zodiacProfile.animal}}系 · {{zodiacProfile.label}}</view>
          <view class="five-element-info">
            <view class="five-element-item">
              <text class="five-element-label">主运势轴</text>
              <text class="five-element-value">{{zodiacProfile.focusAxisLabel}}</text>
            </view>
            <view class="five-element-item">
              <text class="five-element-label">签文共振</text>
              <text class="five-element-value">{{zodiacProfile.signAxisLabel}}</text>
            </view>
            <view class="five-element-item">
              <text class="five-element-label">开运动作轴</text>
              <text class="five-element-value">{{zodiacProfile.ritualAxisLabel}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{analysis && analysis.actionTips && analysis.actionTips.length}}" class="action-tips-card {{showAnimations ? 'fade-in' : ''}}">
          <view class="action-tips-title">今日好运行动建议</view>
          <view class="action-tip" wx:for="{{analysis.actionTips}}" wx:key="index">✅ {{item}}</view>
        </view>

        <view wx:if="{{dailyQuote}}" class="quote-card {{showAnimations ? 'fade-in' : ''}}">
          <view class="quote-card-title">今日好运签</view>
          <text class="quote-card-text">「{{dailyQuote}}」</text>
        </view>

        <view class="ritual-card {{showAnimations ? 'fade-in' : ''}}">
          <view class="ritual-title">今日好运仪式</view>
          <view class="ritual-streak">连续点亮：{{ritualStreakDays}} 天</view>
          <view class="ritual-text">{{dailyRitualText}}</view>
          <button class="btn-ritual {{dailyRitualDone ? 'btn-ritual-done' : ''}}" bindtap="lightUpToday">
            {{dailyRitualDone ? '✨ 今日已点亮' : '✨ 点亮今日好运'}}
          </button>
        </view>

        <!-- 专属称号 -->
        <view wx:if="{{cityDetail.title}}" class="title-card {{showAnimations ? 'slide-up' : ''}}" style="animation-delay: {{0.9 + (cityDetail.tags.length + 1) * 0.15}}s">
          <view class="title-label">你的专属称号</view>
          <view class="title-name">{{cityDetail.title}}</view>
        </view>

        <!-- 治愈语录 -->
        <view wx:if="{{cityDetail.healing}}" class="healing-card {{showAnimations ? 'fade-in' : ''}}" style="animation-delay: 1s">
          <view class="healing-icon">💝</view>
          <text class="healing-text">{{cityDetail.healing}}</text>
        </view>

        <!-- 综合幸运建议（统一口径） -->
        <view wx:if="{{luckyPlan}}" class="lucky-card {{showAnimations ? 'slide-up' : ''}}" style="animation-delay: {{1.1 + (cityDetail.tags.length + 1) * 0.15}}s">
          <view class="lucky-title">综合幸运建议</view>
          <view class="lucky-items">
            <view class="lucky-item">
              <text class="lucky-label">幸运色</text>
              <text class="lucky-value">{{luckyPlan.color}}</text>
            </view>
            <view class="lucky-item">
              <text class="lucky-label">主幸运数字</text>
              <text class="lucky-value">{{luckyPlan.number}}</text>
            </view>
            <view class="lucky-item">
              <text class="lucky-label">幸运物</text>
              <text class="lucky-value">{{luckyPlan.thing}}</text>
            </view>
          </view>
          <text class="lucky-note">{{luckyPlan.note}}</text>
        </view>
      </view>
    </view>

    <!-- 按钮区域 -->
    <view class="btn-area {{showAnimations ? 'slide-up' : ''}}" style="animation-delay: 0.8s">
      <block wx:if="{{actionOrder === 'share_first'}}">
        <button class="btn-share" open-type="share" bindtap="onTapShareButton">
          📲 微信分享
        </button>
        <button class="btn-poster" bindtap="generatePoster">
          🖼️ 生成海报
        </button>
        <button class="btn-copy" bindtap="copyResult">
          📝 复制长文案
        </button>
        <button class="btn-restart" bindtap="restartTest">
          🔄 再测一次
        </button>
      </block>
      <block wx:else>
        <button class="btn-restart" bindtap="restartTest">
          🔄 再测一次
        </button>
        <button class="btn-share" open-type="share" bindtap="onTapShareButton">
          📲 微信分享
        </button>
        <button class="btn-poster" bindtap="generatePoster">
          🖼️ 生成海报
        </button>
        <button class="btn-copy" bindtap="copyResult">
          📝 复制长文案
        </button>
      </block>
    </view>

    <!-- 底部装饰 -->
    <view class="bottom-decor {{showAnimations ? 'fade-in' : ''}}" style="animation-delay: 1s">
      <text>🎇</text>
      <text>✨</text>
      <text>🎆</text>
    </view>
  </view>

  <!-- 海报预览弹窗 -->
  <view class="poster-modal" wx:if="{{showPosterModal}}" bindtap="closePosterModal">
    <view class="poster-content" catchtap="preventClose">
      <image class="poster-image" src="{{posterImage}}" mode="widthFix"></image>
      <button class="btn-save" bindtap="savePosterToAlbum">保存到相册</button>
      <view class="close-hint">点击空白处关闭</view>
    </view>
  </view>

  <!-- 隐藏的canvas用于生成海报 -->
  <canvas canvas-id="posterCanvas" class="hide-canvas"></canvas>
</view>
