<!--pages/index/index.wxml-->
<view class="container">
  <!-- 装饰元素 -->
  <text class="decoration top-left">🧧</text>
  <text class="decoration top-right">🎊</text>
  <text class="decoration bottom-left">🏮</text>
  <text class="decoration bottom-right">🎇</text>

  <!-- 主标题 -->
  <view class="title-wrap">
    <text class="title">2026</text>
    <text class="title-second">新年旺旺</text>
  </view>

  <!-- 副标题 -->
  <text class="subtitle">测测你的开年旅游地</text>

  <!-- 吉祥话 -->
  <view class="lucky-words">
    <text>🎉 新年行大运</text>
    <text>🧧 财源滚滚来</text>
    <text>🏮 步步高升</text>
  </view>

  <!-- 开始按钮 -->
  <button class="btn-primary" bindtap="startTest">
    {{hasUnfinishedQuiz ? ('继续测试（' + unfinishedProgressText + '）') : '开始测试'}}
  </button>

  <view wx:if="{{hasHistory}}" class="history-card">
    <text class="history-title">你上次的好运城市：{{historyCity}}</text>
    <button class="btn-secondary" bindtap="continueLastResult">继续查看上次结果</button>
  </view>

  <view class="quote-card">
    <text class="quote-title">今日好运签</text>
    <text class="quote-text">「{{dailyQuote}}」</text>
  </view>

  <view class="mission-card">
    <text class="mission-title">今日好运任务</text>
    <text class="mission-text">{{dailyMission}}</text>
    <button class="btn-mission-copy" bindtap="copyDailyCard">复制好运卡</button>
  </view>

  <view class="streak-card">
    <text class="streak-title">点亮连续天数</text>
    <text class="streak-days">{{ritualStreakDays}} 天</text>
    <text class="streak-desc">{{ritualLastCity ? ('最近点亮城市：' + ritualLastCity) : '今天点亮一下，开启你的连续记录'}}</text>
  </view>

  <view wx:if="{{recentHistory.length > 0}}" class="history-list-card">
    <text class="history-list-title">最近测试记录</text>
    <view class="history-item" wx:for="{{recentHistory}}" wx:key="index" bindtap="openHistoryResult" data-index="{{index}}">
      <text class="history-item-city">{{item.city}}</text>
      <text class="history-item-time">{{item.displayTime}}</text>
    </view>
  </view>

  <!-- 底部说明 -->
  <text class="tips">{{totalQuestions}}道题 · 测出你的福气城市</text>
  <text class="insights-link" bindtap="openInsights">体验数据看板（内测）</text>
</view>
